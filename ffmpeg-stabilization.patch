@@ -1909,6 +1927,49 @@ static int queue_frame(AVFilterLink *link, AVFrame *input_frame)
 
     relative = decompose_transform(model.matrix);
 
+    // The renderer rotates about the frame centre, whereas the fitted matrix
+    // is expressed about the origin. Convert translation to that centre.
+    relative.translation.s[0] += (model.matrix[0] - 1) * input_frame->width / 2 +
+                                model.matrix[1] * input_frame->height / 2;
+    relative.translation.s[1] += model.matrix[3] * input_frame->width / 2 +
+                                (model.matrix[4] - 1) * input_frame->height / 2;
+    if (!isfinite(relative.translation.s[0]) || !isfinite(relative.translation.s[1]) ||
+        !isfinite(relative.rotation) || !isfinite(relative.scale.s[0]) ||
+        !isfinite(relative.scale.s[1]) ||
+        fabsf(relative.translation.s[0]) > input_frame->width * 0.1f ||
+        fabsf(relative.translation.s[1]) > input_frame->height * 0.1f ||
+        fabsf(relative.rotation) > 0.05f ||
+        fabsf(relative.scale.s[0] - 1) > 0.02f ||
+        fabsf(relative.scale.s[1] - 1) > 0.02f ||
+        fabsf(relative.skew.s[0]) > 0.02f)
+        goto no_motion_data;
+    relative.scale.s[0] = relative.scale.s[1] = 1.0f;
