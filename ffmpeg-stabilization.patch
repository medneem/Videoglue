+            float x = p.p1.s[0] - input_frame->width / 2.0f;
+            float y = p.p1.s[1] - input_frame->height / 2.0f;
+            float dx = (c - 1) * x - s * y + relative.translation.s[0];
+            float dy = s * x + (c - 1) * y + relative.translation.s[1];
+            if (hypotf(dx - (p.p2.s[0] - p.p1.s[0]),
+                       dy - (p.p2.s[1] - p.p1.s[1])) <= 1.0f) {
+                support++;
+                min_x = FFMIN(min_x, p.p1.s[0]); max_x = FFMAX(max_x, p.p1.s[0]);
+                min_y = FFMIN(min_y, p.p1.s[1]); max_y = FFMAX(max_y, p.p1.s[1]);
+            }
+        }
+        if (support < 10 || support * 5 < num_vectors * 3 ||
+            max_x - min_x < input_frame->width * 0.5f ||
+            max_y - min_y < input_frame->height * 0.5f)
+            goto no_motion_data;
+    }
